{
  "name": "ottrip",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "expo:doctor": "pnpm dlx expo-doctor",
    "env:pull": "eas env:pull --environment development",
    "build:dev": "eas build --profile dev",
    "build:alpha": "eas build --profile alpha",
    "build:prod": "eas build --profile prod",
    "build:alpha:ios": "eas build --profile alpha --platform ios",
    "deploy:dev": "eas update --environment=development --branch=dev --auto",
    "deploy:prod": "eas update --environment=production --branch=production --auto",
    "clean": "rm -rf node_modules && pnpm install",
    "prebuild": "pnpm typecheck && pnpm lint:check",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.3",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-google-maps/api": "^2.20.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.4.8",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.9",
    "@tanstack/react-query": "^5.90.5",
    "@types/google.maps": "^3.65.5",
    "aircodes": "^1.3.16",
    "axios": "^1.6.8",
    "expo": "^57.0.28",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "^57.0.3",
    "expo-image-picker": "^57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18n-iso-countries": "^7.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-big-calendar": "^4.18.4",
    "react-native-calendars": "^1.1313.0",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-maps": "^1.27.2",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "ts-pattern": "^5.7.1",
    "tslib": "^2.8.1",
    "zod": "^3.25.72"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "1.9.4",
    "@types/react": "~19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-plugin-module-resolver": "^5.0.2",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.12.4",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "immer",
          "@react-native-kakao/core",
          "@react-native-kakao/user",
          "@suspensive/react",
          "@tanstack/react-form",
          "colord",
          "es-toolkit",
          "ky",
          "ts-brand",
          "ts-pattern"
        ]
      }
    }
  }
}
